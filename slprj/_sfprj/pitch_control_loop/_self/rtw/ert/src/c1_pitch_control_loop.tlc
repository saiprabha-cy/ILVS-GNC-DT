%implements "chartSource" "C"
%function ChartConfig(block, system) void
  %createrecord chartConfiguration { ...
          executeAtInitialization  0 ...
  }
  %return chartConfiguration
%endfunction
%function ChartDataMap(block, system) void
  %createrecord ChartDataElements {\
    NumChartData   3 \
    ChartDataDefaults {\
      RecordType   "ChartData"\
      Dimensions   []\
      IsTestPoint  0\
    }\
    ChartData {\
      Name         "integral"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "pitch_control_loop:5:510-518"\
    }\
    ChartData {\
      Name         "prev_err"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "pitch_control_loop:5:519-527"\
    }\
    ChartData {\
      Name         "first_call"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "pitch_control_loop:5:528-538"\
    }\
  }
  %return ChartDataElements
%endfunction
